          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Family Planner queue-stuck check. Mirrors the tested\n// app/n8n/queue-stuck-check.code-node.js (evaluateQueue). Counts email_queue\n// rows parked at failed:true (exhausted 3 retries, not later re-sent) and emits\n// EXACTLY ONE status item so the downstream IF + Heartbeats never short-circuit\n// on zero items. Alerts via healthchecks.io, NOT email (the alert must not\n// depend on the same Gmail SMTP that breaks).\nconst map = ($input.first() && $input.first().json && typeof $input.first().json === 'object' && !Array.isArray($input.first().json)) ? $input.first().json : {};\nconst ids = Object.keys(map);\nconst stuckIds = [];\nfor (const id of ids) {\n  const e = map[id];\n  if (e && e.failed === true && e.sent !== true) stuckIds.push(id);\n}\nreturn [{ json: {\n  clean: stuckIds.length === 0,\n  stuck: stuckIds.length,\n  total: ids.length,\n  ids: stuckIds.slice(0, 20)\n} }];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-224, 0],
        "id": "b3333333-0000-4000-8000-000000000003",
        "name": "Check"
      },
      {
        "parameters": {
          "conditions": {
            "options": { "caseSensitive": true, "version": 2 },
            "conditions": [
              {
                "id": "is-clean",
                "leftValue": "={{ $json.clean }}",
                "rightValue": "",
                "operator": { "type": "boolean", "operation": "true", "singleValue": true }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [-16, 0],
        "id": "b4444444-0000-4000-8000-000000000004",
        "name": "Clean?"
      },
      {
        "parameters": {
          "url": "https://hc-ping.com/REPLACE-WITH-QueueStuckCheck-UUID",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [208, -120],
        "id": "b5555555-0000-4000-8000-000000000005",
        "name": "Heartbeat (up)"
      },
      {
        "parameters": {
          "url": "https://hc-ping.com/REPLACE-WITH-QueueStuckCheck-UUID/fail",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [208, 120],
        "id": "b6666666-0000-4000-8000-000000000006",
        "name": "Heartbeat (fail)"
      }
    ],
    "connections": {
      "Schedule Trigger": { "main": [[{ "node": "Get email_queue", "type": "main", "index": 0 }]] },
      "Get email_queue": { "main": [[{ "node": "Check", "type": "main", "index": 0 }]] },
      "Check": { "main": [[{ "node": "Clean?", "type": "main", "index": 0 }]] },
