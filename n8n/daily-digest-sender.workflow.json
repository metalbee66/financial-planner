        "parameters": {
          "jsCode": "// Mirrors composeDigestSummary + buildDigestEmail from notifications.js.\n// v2.1.2 fix: emit one {_sentinel:true} item on a quiet day so the heartbeat\n// chain never short-circuits on zero items.\nconst NOTIFICATION_KINDS = ['task_assigned', 'comment_added', 'dependency_unblocked', 'task_due_soon', 'task_overdue', 'milestone_completed', 'project_completed'];\nconst DIGEST_KIND_LABELS = {\n  task_assigned:        { one: 'task assigned',       many: 'tasks assigned' },\n  comment_added:        { one: 'new comment',         many: 'new comments' },\n  dependency_unblocked: { one: 'task unblocked',      many: 'tasks unblocked' },\n  task_due_soon:        { one: 'task due soon',       many: 'tasks due soon' },\n  task_overdue:         { one: 'task overdue',        many: 'tasks overdue' },\n  milestone_completed:  { one: 'milestone completed', many: 'milestones completed' },\n  project_completed:    { one: 'project completed',   many: 'projects completed' },\n};\nconst USER_TO_EMAIL = { brad: 'metalbee66@gmail.com', diana: 'dianaleshcheva@gmail.com' };\nconst BASE_URL = 'https://metalbee66.github.io/financial-planner/';\nconst esc = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nfunction composeDigestSummary(entries) {\n  const counts = new Map();\n  for (const e of entries) {\n    if (!e || !e.kind || !DIGEST_KIND_LABELS[e.kind]) continue;\n    counts.set(e.kind, (counts.get(e.kind) || 0) + 1);\n  }\n  const parts = [];\n  for (const k of NOTIFICATION_KINDS) {\n    const n = counts.get(k);\n    if (!n) continue;\n    const l = DIGEST_KIND_LABELS[k];\n    parts.push(`${n} ${n === 1 ? l.one : l.many}`);\n  }\n  return parts.join(', ');\n}\n\nconst data = $input.first().json || {};\nconst out = [];\nfor (const [user, entries] of Object.entries(data)) {\n  if (!Array.isArray(entries) || entries.length === 0) continue;\n  const to = USER_TO_EMAIL[user];\n  if (!to) continue;\n  const summary = composeDigestSummary(entries);\n  if (!summary) continue;\n  const bullets = entries.map(e => `<li><strong>${esc(e.title || '')}</strong> — ${esc(e.summary || '')}</li>`).join('');\n  const bodyHtml = `<p>${esc(summary)}.</p><ul>${bullets}</ul><p><a href=\"${esc(BASE_URL)}\">Open Family Planner</a></p>`;\n  out.push({ json: { _sentinel: false, _user: user, to, subject: `[Family Planner] Daily digest — ${summary}`, bodyHtml } });\n}\nif (out.length === 0) return [{ json: { _sentinel: true } }];\nreturn out;\n"
        },
